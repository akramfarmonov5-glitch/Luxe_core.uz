# ============================================================
# LUXECORE — Environment variables
# `.env.local` ga nusxalab to'ldiring (commit qilinmaydi).
# ============================================================

# Site URL — sitemap, catalog feed, OG tags uchun ishlatiladi
NEXT_PUBLIC_SITE_URL=https://luxe-core-uz-three.vercel.app

# Supabase (client + server)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase server-only (order tracking uchun shart)
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini AI (chat + opt-in TTS)
GEMINI_API_KEY=
# Optional: model overrides
# GEMINI_TEXT_MODEL=gemini-2.5-flash
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Telegram (buyurtma bildirishnomalari uchun)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
