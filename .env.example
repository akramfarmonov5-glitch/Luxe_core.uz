# ============================================================
# LUXECORE — Environment variables
# `.env.local` ga nusxalab to'ldiring (commit qilinmaydi).
# ============================================================

# Site URL — sitemap, catalog feed, OG tags uchun ishlatiladi
NEXT_PUBLIC_SITE_URL=https://luxe-core-uz-three.vercel.app

# Supabase (client + server)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase server-only (order tracking uchun shart)
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini AI (chat + opt-in TTS)
GEMINI_API_KEY=
# Optional: model overrides
# GEMINI_TEXT_MODEL=gemini-2.5-flash
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Telegram (buyurtma bildirishnomalari uchun)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_INTERNAL_SECRET=

# Telegram bot -> storefront ichki order API aloqasi uchun
BOT_INTERNAL_SECRET=

# ------------------------------------------------------------------
# Analitika (majburiy emas, lekin bo'lmasa eventlar yozilmaydi)
# ------------------------------------------------------------------
# Meta (Facebook) Pixel — lib/fpixel.ts shu o'zgaruvchini o'qiydi
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=
# GA4 Measurement ID (masalan: G-XXXXXXXXXX) — lib/analytics.ts eventlari uchun
NEXT_PUBLIC_GA_ID=

# Firebase Web Push (klient)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK (server, /api/admin/push uchun) — JSON satr ko'rinishida
FIREBASE_ADMIN_SDK_SERVICE_ACCOUNT=

# ------------------------------------------------------------------
# Media (Cloudinary)
# ------------------------------------------------------------------
# Eslatma: unsigned preset o'rniga imzolangan yuklash (signed upload) tavsiya etiladi.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------
# SEO / verifikatsiya
# ------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=

# ------------------------------------------------------------------
# Rate limit (ixtiyoriy, lekin PROD uchun tavsiya etiladi)
# ------------------------------------------------------------------
# Vercel'da jarayon xotirasi instanslar orasida bo'linmaydi — Redis bo'lmasa
# limit amalda ishlamaydi. Upstash yoki Vercel KV (REST) ulang:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel KV bo'lsa (avtomatik beriladi):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
